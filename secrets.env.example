# Legacy XML feed credentials (only needed when FOOTY_TIPPER_FEED_SOURCE=feed)
PASSWORD=
BASE_URL=
NRL_FIXTURES_EXTENTION=
NRL_ROUND_LADDER_EXTENTION=
NRL_PERFORMANCE_EXTENTION=

# Data source switch: python (nrl.com ingestion, default) | feed (legacy XML)
# FOOTY_TIPPER_FEED_SOURCE=python
# FOOTY_TIPPER_NRL_DATA_ENABLED=true
# FOOTY_TIPPER_NRL_DATA_AUTO_BACKFILL=true
# FOOTY_TIPPER_NRL_DATA_MAX_PAGES=

# Live pre-game odds (The Odds API is the production/GitHub Actions default)
ODDS_API_KEY=
# FOOTY_TIPPER_LIVE_ODDS_PROVIDER=the_odds_api

# Betfair Exchange operator fallback (delayed app key is sufficient)
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Override only when the Betfair account belongs to another jurisdiction.
# BETFAIR_IDENTITY_URL=https://identitysso.betfair.com.au/api/login
# FOOTY_TIPPER_ODDS_HIST_URL=https://www.aussportsbetting.com/historical_data/nrl.xlsx

# Drive + email integration (required for send/predict send step)
FOLDER_ID=
FOLDER_URL=
MY_EMAIL=
EMAIL_PASSWORD=

# Claude (Anthropic) integration (optional, fallback copy is used when missing)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI integration, used only for banner image generation (optional)
OPENAI_KEY=
# OPENAI_MODEL=

# Optional CLI defaults
# FOOTY_TIPPER_TEST_EMAIL=you@example.com
# FOOTY_TIPPER_EMAIL_BANNER=images/email-banner.png

# Optional lineup ingestion controls
# FOOTY_TIPPER_LINEUPS_ENABLED=true
# FOOTY_TIPPER_LINEUPS_MODE=recent
# FOOTY_TIPPER_LINEUPS_MAX_ARTICLES=80
# FOOTY_TIPPER_LINEUPS_BACKFILL_MAX_ARTICLES=2000
# FOOTY_TIPPER_LINEUPS_INCLUDE_SITEMAP_IN_RECENT=false
# FOOTY_TIPPER_LINEUPS_STRICT=false
# FOOTY_TIPPER_LINEUPS_AUTO_BACKFILL=true
# FOOTY_TIPPER_LINEUPS_AS_OF_HOURS_BEFORE_KICKOFF=24
# FOOTY_TIPPER_LINEUP_MONTE_CARLO_SAMPLES=64
# FOOTY_TIPPER_LINEUP_MU_NOISE_SCALE=0.12

# Optional delivery / site / ops controls
# FOOTY_TIPPER_SITE_URL=https://<user>.github.io/footy-tipper/site/
# FOOTY_TIPPER_DB_BACKUP=true
# FOOTY_TIPPER_LINEUP_FEATURES_STRICT=false
# FOOTY_TIPPER_EVAL_SEASONS=3

# Optional season scope (docs/getting-started.md)
# FOOTY_TIPPER_START_YEAR=2008
# FOOTY_TIPPER_END_YEAR=              # defaults to the current year
# FOOTY_TIPPER_INCLUDE_PERFORMANCE=true

# Optional modelling controls (2026-07 upgrades)
# FOOTY_TIPPER_TUNE_TIER_A=true
# FOOTY_TIPPER_TUNE_ITER=100
# FOOTY_TIPPER_EVAL_REPORT_PATH=
# Seeds the Bayesian search and every LightGBM fit. Keep it fixed when comparing
# two feature sets, or the comparison measures search noise, not the change.
# FOOTY_TIPPER_TRAINING_SEED=20100308
# Send missing predictors to LightGBM as NaN instead of 0.0. Baked into the
# fitted transformer, so it only takes effect on the next train.
# FOOTY_TIPPER_NAN_PASSTHROUGH=false

# Explainability (docs/explainability.md); false skips the diagnostics write
# FOOTY_TIPPER_EXPLAIN=true

# Joker strategy (docs/joker-strategy.md)
# FOOTY_TIPPER_JOKER_STRATEGY=auto      # auto | points | protect | chase
# FOOTY_TIPPER_JOKER_POINTS_GAP=0       # points behind leader (negative = leading)
# FOOTY_TIPPER_JOKER_RISK_LAMBDA=
# FOOTY_TIPPER_JOKER_MIN_ROUNDS_WITH_ODDS=
# FOOTY_TIPPER_JOKER_MIN_ROUND_COVERAGE=
# FOOTY_TIPPER_JOKER_MIN_MARGIN_RATIO=
# FOOTY_TIPPER_JOKER_POLICY_PATH=
# FOOTY_TIPPER_JOKER_BACKTEST_SIMULATIONS=
# FOOTY_TIPPER_JOKER_BACKTEST_FIELD_SIZE=
# FOOTY_TIPPER_JOKER_BACKTEST_SEED=

# Value picks and staking (docs/principled-odds-integration.md)
# FOOTY_TIPPER_MIN_VALUE_EDGE=
# FOOTY_TIPPER_KELLY_FRACTION=
# FOOTY_TIPPER_MAX_STAKE_FRACTION=
# FOOTY_TIPPER_MIN_STAKE_FRACTION=
# FOOTY_TIPPER_STAKE_MODE=normalized    # normalized | bankroll
# FOOTY_TIPPER_BANKROLL=

# Competition strategy layer (docs/comp-strategy.md)
# FOOTY_TIPPER_COMP_STRATEGY=advisory   # off | advisory | auto
# FOOTY_TIPPER_COMP_GAP=0               # points behind leader (negative = leading)
# FOOTY_TIPPER_COMP_FIELD_SIZE=75
# FOOTY_TIPPER_COMP_MAX_FLIPS=2
# FOOTY_TIPPER_COMP_SIMULATIONS=8000
# FOOTY_TIPPER_COMP_MIN_PWIN_GAIN=0.002
# FOOTY_TIPPER_COMP_USER_EDGE=0.15
# FOOTY_TIPPER_COMP_FLIP_BAND_LO=0.38
# FOOTY_TIPPER_COMP_FLIP_BAND_HI=0.62
# FOOTY_TIPPER_COMP_ROUNDS_LEFT=        # optional future-round cap

# R interpreter for data preparation. Bare "Rscript" resolves through PATH, so
# an activated conda env carrying its own R shadows the one R_LIBS_USER was
# built against. Package shared objects are named .so by a CRAN build and
# .dylib by a conda build and are tied to the R minor version, so a mismatch
# fails at load with a missing shared object rather than a version error.
# Set this to the interpreter that owns ~/R/library.
# FOOTY_TIPPER_RSCRIPT=/usr/local/bin/Rscript
