flowchart TB
  NRL[/nrl.com Team Lists<br/>Late Mail · match-day lists/]
  DISCOVER([Discover URLs<br/>recent hub or backfill sitemap])
  FETCH([Polite fetch and parse<br/>modern + 2012–2018 text layouts])
  HASH{Content hash<br/>already stored?}
  HEALTHY{Existing snapshot<br/>has entries?}
  SKIP([Skip identical<br/>healthy version])
  REPAIR([Repair zero-entry snapshot<br/>with improved parser])
  INSERT([Insert new article version<br/>and normalized entries])
  STORE[(lineup_article_snapshots<br/>lineup_entries · ingestion_runs)]
  CONTEXT{Feature context?}
  TRAIN([Training cutoff<br/>latest at kickoff minus 24h])
  INFER([Inference cutoff<br/>latest known pre-game version])
  ELIGIBLE{Eligible snapshot<br/>available?}
  FEATURES[[Shared lineup features<br/>roles · continuity · cohesion · churn]]
  DEFAULTS([Safe defaults<br/>missingness exposed])
  UNC[[Selection uncertainty model<br/>snapshot transition history]]
  MODEL([Tier-B probability<br/>deterministic Monte Carlo marginalization])

  NRL --> DISCOVER
  DISCOVER --> FETCH
  FETCH --> HASH
  HASH -->|no| INSERT
  HASH -->|yes| HEALTHY
  HEALTHY -->|yes| SKIP
  HEALTHY -->|no| REPAIR
  INSERT --> STORE
  REPAIR --> STORE
  SKIP --> STORE
  STORE --> CONTEXT
  CONTEXT -->|historical Final row| TRAIN
  CONTEXT -->|current Pre Game row| INFER
  TRAIN --> ELIGIBLE
  INFER --> ELIGIBLE
  ELIGIBLE -->|yes| FEATURES
  ELIGIBLE -->|no| DEFAULTS
  FEATURES --> UNC
  DEFAULTS --> UNC
  UNC --> MODEL

