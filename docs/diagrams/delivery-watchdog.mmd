flowchart TB
  SCHEDULE[(Drive schedule.json<br/>next actionable round)]
  DELIVERY_STATE[(Drive round marker<br/>and SQLite email_sends)]
  SMTP[/SMTP production delivery/]
  ALERT[/One assigned GitHub issue<br/>label: automation-alert/]

  subgraph PRIMARY[Primary hosted clock — GitHub Actions]
    direction LR
    GH_CLOCK([Off-boundary Sydney polls<br/>11:07 through 14:37])
  end

  subgraph FALLBACK[Independent hosted clock — Google Apps Script]
    direction TB
    GOOGLE_CLOCK([Five-minute installed trigger])
    SLOT{Sydney recovery slot?<br/>11:22 through 14:52}
    LAST_SLOT[(LAST_SUCCESSFUL_<br/>SLOT)]
    TOKEN[(Script Property<br/>GITHUB_TOKEN only)]
    DISPATCH([Dispatch predict.yml<br/>watchdog=true only])
    NO_DISPATCH([No dispatch])

    GOOGLE_CLOCK --> SLOT
    LAST_SLOT --> SLOT
    SLOT -->|outside window or already sent| NO_DISPATCH
    SLOT -->|eligible| DISPATCH
    TOKEN --> DISPATCH
    DISPATCH -->|accepted| LAST_SLOT
  end

  subgraph WORKFLOW[Shared predict.yml safety boundary]
    direction TB
    GUARD{Watchdog actor matches<br/>repository variable?<br/>No confirmed_round?}
    GATE{Drive-backed schedule gate<br/>live · refresh · skip}
    SKIP([Stop after gate<br/>no production mutation])
    LOCK([Serialized prediction/delivery<br/>concurrency group])
    PREDICT([Refresh data · infer · decide])
    MODE{Gate mode}
    REFRESH([Push runtime and publish site<br/>no email])
    PREPARE([Validate sender · token · Sheet<br/>freeze recipients])
    CLAIM{Round claimable?}
    BLOCK([Block duplicate or uncertain send])
    EMAIL([SMTP attempt])
    RECONCILE([Mark sent · reconcile ledger<br/>push runtime · publish site])
    FAIL([Automated gate or prediction failure])

    GUARD -->|yes| GATE
    GUARD -->|no| FAIL
    GATE -->|skip| SKIP
    GATE -->|live or refresh| LOCK
    LOCK --> PREDICT --> MODE
    MODE -->|refresh| REFRESH
    MODE -->|live| PREPARE --> CLAIM
    CLAIM -->|no| BLOCK
    CLAIM -->|yes: pending marker| EMAIL
    EMAIL -->|full success| RECONCILE
    EMAIL -->|partial · refused · ambiguous| BLOCK
    GATE -.->|failure| FAIL
    PREDICT -.->|failure| FAIL
  end

  GH_CLOCK --> GATE
  DISPATCH --> GUARD
  SCHEDULE --> GATE
  DELIVERY_STATE --> CLAIM
  CLAIM --> DELIVERY_STATE
  EMAIL --> SMTP
  RECONCILE --> DELIVERY_STATE
  FAIL -->|create or update| ALERT
  RECONCILE -->|successful live closes| ALERT

