flowchart TB
  DATA[(Final rows for training<br/>Pre Game rows for inference)]
  FOOTBALL([Match · ladder · performance<br/>and as-of lineup features])
  ODDS[/Fresh H2H · spread · totals/]

  A[[Tier A<br/>sequential baseline]]
  B[[Tier B<br/>home and away score models]]
  C[[Tier C<br/>binary winner model]]
  MARKET[[Genuine H2H<br/>market expert]]
  BLEND[[Learned score-mean blend<br/>Tier A + Tier B]]
  UNC([Lineup uncertainty<br/>marginalization])
  STACK[[Market/no-market simplex pools<br/>nonnegative · no intercept]]
  CAL[[Positive-temperature calibration<br/>neutral stays 50%]]
  MARGIN[[Margin ridge<br/>model + line + Tier A]]
  DISP{Valid dispersion<br/>estimate?}
  SIM([Bivariate score simulation<br/>shared lambda3])
  SCOREMEANS([Fresh spread/total blends<br/>adjust expected score means])
  COHERE([Probability · scoreline · margin<br/>final consistency check])
  OUT[(predictions_table<br/>tip · probability · margin · scoreline)]

  DATA --> FOOTBALL
  FOOTBALL --> A
  FOOTBALL --> B
  FOOTBALL --> C
  ODDS --> MARKET
  A --> BLEND
  B --> BLEND
  B --> DISP
  BLEND --> UNC
  A --> STACK
  UNC --> STACK
  C --> STACK
  MARKET --> STACK
  STACK --> CAL
  BLEND --> MARGIN
  ODDS --> MARGIN
  A --> MARGIN
  BLEND --> SCOREMEANS
  MARGIN --> SCOREMEANS
  ODDS --> SCOREMEANS
  SCOREMEANS --> SIM
  CAL --> SIM
  DISP -->|yes: gamma-mixed Poisson| SIM
  DISP -->|no: Poisson fallback| SIM
  SIM --> COHERE
  CAL --> COHERE
  COHERE --> OUT

