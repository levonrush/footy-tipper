flowchart TB
  OP[/Operator/]
  ACTIONS[/GitHub Actions<br/>prediction/delivery · production-image checks/]
  GOOGLE_CLOCK[/Google Apps Script watchdog<br/>five-minute clock · 30-minute slots/]
  NRL[/nrl.com match data/]
  ODDS[/Historical and live odds/]
  LINEUP_SOURCE[/Team Lists and Late Mail/]
  SMTP[/SMTP and test recipient/]
  PAGES[/GitHub Pages/]

  CLI([Human CLI<br/>menu · status · tips · update-model])
  MACHINE([Actions runner<br/>exact modes · never trains])
  INGEST([Python source and lineup ingestion])
  PREP([R preparation])
  TRAIN_DB[(Local training DB<br/>authoritative history)]
  RUNTIME_DB[(Runtime SQLite<br/>predictions · ledgers)]
  RUNTIME_STATE[(Drive runtime state<br/>DB · schedule)]
  TRAIN[[Staged local training<br/>100 candidates]]
  VERIFY{Local inference and<br/>hash validation pass?}
  RELEASE[[Immutable model release<br/>archive · receipt]]
  MODEL_CHECK{Actions production image<br/>loads exact release?}
  POINTER[(Active model pointer)]
  GATE{Schedule gate<br/>live · refresh · skip}
  INFER([Inference and simulation])
  DECIDE([Tips · value · stakes · joker])
  MODE{Exact run mode}
  PREP_EMAIL([Prepare production envelope<br/>credentials · token · recipients])
  NO_CLAIM([Fail safely<br/>no marker · no SMTP])
  MARKER[(Delivery marker<br/>pending = uncertain · sent)]
  EMAIL([Email delivery])
  BLOCK([Fail run<br/>keep pending/uncertain])
  ALERT([Create or update assigned<br/>automation-alert issue])
  SYNC([Push runtime DB and schedule only])
  SITE([Generate site])

  OP --> CLI
  CLI -->|update-model| INGEST
  CLI -->|tips commands and advanced live aliases| ACTIONS
  ACTIONS --> MACHINE
  MACHINE --> GATE
  GOOGLE_CLOCK -->|guarded watchdog=true| ACTIONS
  NRL --> INGEST
  ODDS --> INGEST
  LINEUP_SOURCE --> INGEST
  INGEST --> PREP
  PREP --> TRAIN_DB
  TRAIN_DB --> TRAIN
  TRAIN --> VERIFY
  VERIFY -->|pass| RELEASE
  RELEASE --> MODEL_CHECK
  ACTIONS --> MODEL_CHECK
  MODEL_CHECK -->|pass| POINTER
  POINTER --> MACHINE
  RUNTIME_STATE --> MACHINE
  MACHINE -->|runtime pull| RUNTIME_DB
  MACHINE --> INGEST
  PREP --> RUNTIME_DB
  GATE -->|live or refresh| INFER
  GATE -.->|automated failure| ALERT
  RELEASE --> INFER
  RUNTIME_DB --> INFER
  INFER --> DECIDE
  DECIDE --> MODE
  MODE -->|test| EMAIL
  MODE -->|refresh| SYNC
  MODE -->|live| PREP_EMAIL
  PREP_EMAIL -->|invalid| NO_CLAIM
  PREP_EMAIL -->|valid| MARKER
  MARKER -->|pending claimed| EMAIL
  EMAIL --> SMTP
  SMTP -->|live success marks sent| MARKER
  SMTP -->|live partial · refused · ambiguous| BLOCK
  BLOCK -->|remains| MARKER
  BLOCK -.->|automated failure| ALERT
  MARKER -->|sent then reconcile ledger| RUNTIME_DB
  RUNTIME_DB --> SYNC
  SYNC --> RUNTIME_STATE
  MODE -->|refresh or live| SITE
  SITE --> PAGES
  MARKER -->|successful live closes| ALERT

