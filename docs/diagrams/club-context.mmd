  classDef model fill:#FEF3C7,stroke:#F59E0B,color:#0F172A,stroke-width:2px;
  classDef decision fill:#FEE2E2,stroke:#DC2626,color:#0F172A,stroke-width:2px;

  class ABC,CONFIRM,FIXTURES,READER source;
  class DISCOVER,CUTOFF,FEATURES,ABLATION,FACTS,FALLBACK,REG process;
  class ARTICLES,QUEUE,EVENTS,REPORT,RUN,SNAPSHOT data;
  class PROD,CANDIDATE model;
  class REVIEW,SAFETY decision;
